# Python/runtime noise
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments and caches
.cache/
.conda_node/
.venv/
.venv-streamlit/
venv/
env/
.codex
.codex/
.agents/
.streamlit/secrets.toml
.streamlit/credentials.toml

# A generic local environment file from an older experiment. The supported
# reproducible environment is environment.simlingo.yml.
environment.yml

# Local secrets and credentials. Never commit personal access tokens.
.env
.env.*
*.token
*token*
*secret*
*credential*
credentials.*
secrets.*
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
wandb/

# CARLA/SUMO generated runtime outputs
logs/
generated_routes/
generated_sumo_nets/
generated_sumo_routes/

# Large local backups / temporary research exports
vm_backups/
backup_1ere_version/
backups/
trash/
artifacts/
exports/
SUMO_Project.zip

# Large model and pretrained downloads. Use the download scripts instead.
models/
pretrained/

# Keep the small runtime Dreamer checkpoints that are part of this integration.
*.pt
*.pth
*.ckpt
*.safetensors
!external/simlingo/checkpoints/dreamer_guard/best_world_model.pt
!external/simlingo/checkpoints/dreamer_sdbs_fresh/best_world_model.pt
!external/simlingo/checkpoints/dreamer_ppo_rl_noguard/init_guarded_world_model.pt
!external/simlingo/checkpoints/dreamer_sdbs_rl_noguard/init_guarded_world_model.pt
!external/simlingo/checkpoints/dreamer_ppo_rl_noguard/latest_rl_model.pt
!external/simlingo/checkpoints/dreamer_sdbs_rl_noguard/latest_rl_model.pt

# Keep only the promoted report-aligned RSSM artifact at the repository root.
# Candidates, failed gates, optimizer states, and local training snapshots stay
# on the workstation and can be regenerated from the committed pipeline.
checkpoints/*
!checkpoints/report_aligned_dreamer/
checkpoints/report_aligned_dreamer/*
!checkpoints/report_aligned_dreamer/production/
checkpoints/report_aligned_dreamer/production/*
!checkpoints/report_aligned_dreamer/production/report_dreamer.pt
!checkpoints/report_aligned_dreamer/production/report_dreamer.manifest.json

# Never commit videos, datasets, run archives, or raw notebooks outputs by default.
*.mp4
*.webm
*.avi
*.mov
*.mkv
*.zip
*.tar
*.tar.gz
*.tar.zst
*.7z
*.npz
*.npy
*.pkl
*.parquet
*.jsonl

# Runtime and training datasets are local artifacts, never source code. Keep a
# small inventory so a fresh clone knows how to regenerate them.
data/*
!data/README.md

# DeepAccident is downloaded separately (9 GB mini / 313 GB full). Keep only
# the reproducible preparation and training code in Git.
data/deepaccident/raw/
data/deepaccident/extracted/
data/deepaccident/processed/
checkpoints/deepaccident/

# Historical side experiments are preserved locally but are not dependencies
