cloud_b200/
vm_full_sft_patch/
external/Simple-carla-WAM/
external/alpamayo1.5/
external/alpamayo_official/
external/maram_dreamer/
experiments/maram_dreamer_carla/
docs/VLA_AV_RAPPORT_STAGE_DRAFT*/
docs/rapport_stage/
start.sh

# Local training evidence and candidate artifacts. The promoted report RSSM
# above and the already tracked compact runtime checkpoints are sufficient for
# a fresh runtime clone.
external/simlingo/checkpoints/dreamer_ppo_complement/
external/simlingo/checkpoints/dreamer_ppo_rl_noguard/checkpoint_roles.json
external/simlingo/checkpoints/dreamer_ppo_rl_noguard/offline_warmstarts/
external/simlingo/checkpoints/dreamer_ppo_rl_noguard/protected_snapshots/
external/simlingo/checkpoints/dreamer_ppo_rssm_v2/
external/simlingo/checkpoints/dreamer_ppo_rssm_v3/
external/simlingo/checkpoints/dreamer_ppo_rssm_v4/
external/simlingo/checkpoints/dreamer_ppo_rssm_v4_soft_trial/
external/simlingo/checkpoints/dreamer_sdbs_complement/
external/simlingo/checkpoints/dreamer_sdbs_rl_noguard/offline_warmstarts/

# TwinSentinel vendored code is useful, but its cloned git history, map packs,
# and experiment runs are too large for the main repository.
experiments/TwinSentinel_Project/.git/
experiments/TwinSentinel_Project/runs/
experiments/TwinSentinel_Project/maps/

# Nested upstream git histories should be handled as submodules or flattened
# deliberately before the first root commit.
external/*/.git/
external/*/.git.upstream/
experiments/*/.git/
